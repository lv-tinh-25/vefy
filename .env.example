DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Gemini AI (OCR odometer) — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Supabase Storage (avatar upload)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Auth — Better Auth
BETTER_AUTH_SECRET=random-secret-min-32-chars
# Public origin of the web app (API is served from it at /api); on Vercel set to https://<your-domain>
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailtrap SMTP (email verification)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vefy <noreply@vefy.app>
