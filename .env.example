DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
# Gemini AI (OCR odometer) — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional OCR limits per user (defaults: 10 scans/day, 10s between scans)
# OCR_DAILY_LIMIT=10
# OCR_COOLDOWN_SECONDS=10

# Supabase Storage (avatar upload)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Auth — Better Auth
BETTER_AUTH_SECRET=random-secret-min-32-chars
# Public origin of the web app (API is served from it at /api).
# Optional on Vercel: defaults to the production domain Vercel assigns; set it only for a custom domain.
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailtrap SMTP (email verification)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vefy <noreply@vefy.app>

# Vercel Cron (keeps the Supabase free tier awake) — Vercel sends it as a Bearer token
CRON_SECRET=

# Optional: Google Search Console HTML-tag verification token
GOOGLE_SITE_VERIFICATION=
