# Supabase → Connect → Transaction pooler (port 6543); required on Vercel/serverless
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Gemini AI (OCR odometer) — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional OCR limits per user (defaults: 10 scans/day, 10s between scans)
# OCR_DAILY_LIMIT=10
# OCR_COOLDOWN_SECONDS=10

# Supabase Storage (avatar upload)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Auth — Better Auth
BETTER_AUTH_SECRET=random-secret-min-32-chars
# Public origin of the web app (API is served from it at /api).
# Optional on Vercel: defaults to the production domain Vercel assigns; set it only for a custom domain.
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP (verification + password reset emails) — Gmail with an App Password
# https://myaccount.google.com/apppasswords (requires 2-Step Verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
# Gmail rewrites the sender to SMTP_USER, so keep the same address here
SMTP_FROM=Vefy <you@gmail.com>

# Vercel Cron (keepalive + 08:00 reminders) — Vercel sends it as a Bearer token
CRON_SECRET=

# Web push reminders — generate once with: npx web-push generate-vapid-keys
# Changing the keys invalidates every device that already turned notifications on
# VAPID_SUBJECT must be a real address or https URL: Apple rejects made-up domains
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@gmail.com

# Optional: Google Search Console HTML-tag verification token
GOOGLE_SITE_VERIFICATION=
